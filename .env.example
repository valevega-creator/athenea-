# Copia estas variables en Vercel → Project → Settings → Environment Variables

# Obligatoria: tu clave de la API de Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Opcional: código que la app pedirá antes de usar la IA (recomendado si el sitio es público)
ATHENEA_ACCESS_CODE=

# Opcional: modelo y nivel de esfuerzo (low | medium | high | xhigh | max)
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
